{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "buildCommand": "",
  "functions": {
    "api/*.js": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?p=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/page?p=robots"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?p=privacy"
    },
    {
      "source": "/oferta",
      "destination": "/api/page?p=oferta"
    },
    {
      "source": "/",
      "destination": "/api/page?p=home"
    },
    {
      "source": "/index.html",
      "destination": "/api/page?p=home"
    },
    {
      "source": "/blog",
      "destination": "/api/page?p=blog"
    },
    {
      "source": "/blog/",
      "destination": "/api/page?p=blog"
    },
    {
      "source": "/blog/index.html",
      "destination": "/api/page?p=blog"
    },
    {
      "source": "/blog/:slug.html",
      "destination": "/api/page?p=post&slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?p=post&slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(img|blog/img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}